<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dynamic_search_validator_form" model="ir.ui.view">
        <field name="name">dynamic.search.validator.form</field>
        <field name="model">dynamic.search.validator</field>
        <field name="arch" type="xml">
            <form string="Validate Configuration">
                <sheet>
                    <group>
                        <field name="config_id"/>
                        <field name="is_valid" readonly="1"/>
                    </group>
                    <group>
                        <field name="result" nolabel="1" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_validate" type="object" string="Run Validation" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
