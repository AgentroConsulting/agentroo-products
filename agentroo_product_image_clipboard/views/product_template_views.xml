<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agentroo_product_product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='image_1920']" position="attributes">
                <attribute name="widget">agentroo_product_copy_image</attribute>
                <attribute name="class">oe_avatar</attribute>
                <attribute name="options">
                    {'convert_to_webp': False, 'preview_image': 'image_128', 'copy_button_position': 'center'}
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="agentroo_product_product_template_kanban_view" model="ir.ui.view">
        <field name="name">product.template.kanban.copy.image</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_128']" position="attributes">
                <attribute name="widget">agentroo_product_copy_image</attribute>
                <attribute name="options">{'img_class': 'w-100 object-fit-contain'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
