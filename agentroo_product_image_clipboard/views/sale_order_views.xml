<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agentroo_sale_view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="before">
                <field
                    name="product_image_128"
                    widget="agentroo_sale_line_product_image"
                    class="oe_avatar w-auto float-start"
                    force_save="1"
                    readonly="1"
                />
            </xpath>
        </field>
    </record>
</odoo>
